{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warp",
  "compatibility_date": "2026-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "find_additional_modules": true,

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "workers_dev": true,
  "preview_urls": true,

  // PASSWORD — session-cookie signing / login secret for the panel gate.
  // Production: `wrangler secret put PASSWORD` (never commit it here).
  // Local dev: uncomment and change the value below, or pass
  // `--var PASSWORD:<value>` to `wrangler dev`.
  // "vars": { "PASSWORD": "local-dev-change-me" }
}
