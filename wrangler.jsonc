{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warp",
  "compatibility_date": "2026-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "find_additional_modules": true,

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "workers_dev": true,
  "preview_urls": true,

  // PASSWORD — session-cookie signing / login secret for the panel gate.
  // Production: `wrangler secret put PASSWORD` (never commit it here).
  // Local dev: uncomment and change the value below, or pass
  // `--var PASSWORD:<value>` to `wrangler dev`.
  // "vars": { "PASSWORD": "local-dev-change-me" }

  // ACCOUNT — KV binding holding the WARP account record (ticket 02),
  // written only by the panel's Register/Rotate actions.
  // Production: `wrangler kv namespace create ACCOUNT`, then bind its id:
  // "kv_namespaces": [
  //   { "binding": "ACCOUNT", "id": "<namespace-id>" }
  // ],
  // Local dev: same binding shape with a local namespace id, or use
  // `--kv ACCOUNT:<namespace-id>` with `wrangler dev`.
}
