{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warp",
  "compatibility_date": "2026-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "find_additional_modules": true,

  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "workers_dev": true,
  "preview_urls": true,

  // PASSWORD — session-cookie signing / login secret for the panel gate.
  // Production: `wrangler secret put PASSWORD` (never commit it here).
  // Local dev: uncomment and change the value below, or pass
  // `--var PASSWORD:<value>` to `wrangler dev`.
  // "vars": { "PASSWORD": "local-dev-change-me" }

  // SUB_PATH — subscription path token (ticket 04). The path IS the
  // credential (ADR 0006): GET /api/<SUB_PATH>/sub needs no session, and
  // wrong/missing tokens get a 404. Production: `wrangler secret put
  // SUB_PATH` (long random string, e.g. a 32+ byte hex/base64 value).
  // Local dev: add it to the vars block above, e.g.
  //   "SUB_PATH": "local-dev-change-me"

  // ACCOUNT — KV binding holding the WARP account record (ticket 02),
  // written only by the panel's Register/Rotate actions.
  // Production: `wrangler kv namespace create ACCOUNT`, then bind its id:
  // "kv_namespaces": [
  //   { "binding": "ACCOUNT", "id": "<namespace-id>" }
  // ],
  // Local dev: same binding shape with a local namespace id, or use
  // `--kv ACCOUNT:<namespace-id>` with `wrangler dev`.

  // ENDPOINTS / AWG — KV bindings holding the panel settings (ticket 03):
  // the endpoint list (key "endpoints") and the AmneziaWG toggle + params
  // (key "awg", absent while off). Written only by the panel's settings
  // cards. Create both namespaces, then add them to kv_namespaces above:
  //   { "binding": "ENDPOINTS", "id": "<namespace-id>" },
  //   { "binding": "AWG", "id": "<namespace-id>" }
}
