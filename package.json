{
  "name": "warp-generator",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --local",
    "test": "node --test \"test/**/*.test.mjs\"",
    "goldens:update": "node test/update-goldens.mjs",
    "check:version": "node scripts/check-version.mjs",
    "release:check": "node --check _worker.js && npm test && npm run check:version"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "fflate": "^0.8.3",
    "js-yaml": "^4.1.0"
  }
}
